# Postgres / Redis / TEI
# As portas de host abaixo (5433, 6380) são as expostas por docker-compose.yml
# (DB_PORT/REDIS_PORT). Ajuste-as se colidirem com outro serviço já rodando na
# sua máquina — não precisa mudar nada dentro do compose além da env var.
DATABASE_URL=postgresql://oria:oria_dev@localhost:5433/oria
REDIS_URL=redis://localhost:6380
EMBEDDINGS_URL=http://localhost:8080
EMBEDDINGS_DIM=768

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Um modelo por papel de LLM (ver PROMPTS.md)
LLM_DIALOGUE_MODEL=
LLM_HINT_MODEL=
LLM_FICHAMENTO_MODEL=
LLM_PANORAMA_MODEL=
LLM_QUESTIONS_MODEL=
LLM_CONCEPTS_MODEL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Regras de negócio
ATTEMPT_MAX_STEPS=3
METACOG_CONFIANCA_MIN=70
METACOG_PASSOS_MIN=2.5
RETRIEVAL_LIMIAR=0.72
RETRIEVAL_TOP_K=6

# Servidor
PORT=3000

# Admin e validação do TCC (ver VALIDATION.md)
ADMIN_API_KEY=
VALIDACAO_MODELO=
VALIDACAO_PROVIDER=
VALIDACAO_SEED=
